# docker-compose environment variables.
# Copy this file to .env (in the same directory as docker-compose.yml)
# and edit the values before running `docker compose up -d`.

# MongoDB root credentials (used by the mongo container + the backend connection string)
MONGO_USER=it_admin
MONGO_PASSWORD=change_me_to_a_strong_password

# JWT secrets — generate with: openssl rand -hex 32
JWT_SECRET=run_openssl_rand_hex_32_to_generate_this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=run_openssl_rand_hex_32_to_generate_this_too
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins.
# Include the http://localhost:8080 URL of the frontend container + your prod domain.
CORS_ORIGINS=http://localhost:8080,https://it-ticketing.example.com

# The public URL of the frontend (used in email links)
CLIENT_URL=https://it-ticketing.example.com

# Initial admin account (created by `npm run seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234

# SMTP for production emails (optional in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=IT Ticketing <no-reply@example.com>

# Jameel IT — Help Desk & Ticketing Platform
# © 2026 Mohammed Jameel · https://imohammedjameel.github.io/ · MIT (see LICENSE + NOTICE)
# Signature: JMLIT-4FC9A6FEFD

# Server
PORT=5000
NODE_ENV=development

# Database
DB_URL=mongodb://localhost:27017/it-ticketing

# JWT
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
# Global API budget per IP per window (default 500 — sized for a polling SPA;
# the old default of 100 was too tight and caused 429s during normal browsing)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
# Stricter budget for credential-bearing auth routes ONLY (login, register,
# forgot-password, reset-password, verify-email, resend-verification) —
# brute-force protection. 20 attempts / 15 min / IP by default.
AUTH_RATE_LIMIT_MAX=20

# Client URL (for password reset emails etc.)
CLIENT_URL=http://localhost:5173

# Initial admin account (created by `npm run seed`)
# Aligned with the demo dataset's admin so a fresh seed produces exactly
# 16 users / 1 admin (admin@jameel-it.com / password123).
# CHANGE BOTH for any real deployment.
ADMIN_EMAIL=admin@jameel-it.com
ADMIN_PASSWORD=password123

# SMTP for production emails (optional in dev — falls back to stream transport)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=IT Ticketing <no-reply@example.com>

# ---------------- Logging ----------------
# error | warn | info | debug (default: info in prod, debug in dev)
LOG_LEVEL=

# ---------------- Inbound email → tickets ----------------
# Shared secret for POST /api/inbound/email (SendGrid/Mailgun/webhooks).
# Empty = endpoint disabled.
INBOUND_EMAIL_SECRET=

# ---------------- Business-hours SLA ----------------
# Used when an SLA policy has businessHoursOnly=true
WORK_DAY_START_HOUR=9
WORK_DAY_END_HOUR=17
# 0=Sunday … 6=Saturday (default Sun–Thu work week)
WORK_DAYS=0,1,2,3,4
# Minutes east of UTC (Cairo = 180)
WORK_TZ_OFFSET_MINUTES=180

# ---------------- Optional S3-compatible storage ----------------
# Leave S3_ENABLED=false to store files on the local uploads volume.
# Works with AWS S3, MinIO, DigitalOcean Spaces, Backblaze B2…
S3_ENABLED=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Custom endpoint for MinIO/Spaces (path-style), empty for AWS
S3_ENDPOINT=

# ============================================================
# Root .gitignore — covers everything not handled by the
# Backend/.gitignore and Frontend/.gitignore files.
# ============================================================

# ---- Environment variables (NEVER commit secrets) ----
.env
.env.local
.env.*.local
Backend/.env
Frontend/.env

# Keep the .env.example templates
!.env.example
!Backend/.env.example
!Frontend/.env.example

# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Build output ----
Frontend/dist/
Backend/coverage/
**/coverage/
.nyc_output/

# ---- Test artifacts ----
Frontend/playwright-report/
Frontend/test-results/
Backend/coverage/

# ---- Uploaded files (user data — never commit) ----
Backend/uploads/*
!Backend/uploads/.gitkeep

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ---- Docker ----
# Don't commit the .env used by docker-compose
docker-compose.override.yml

# ---- Misc ----
*.tmp
*.bak
*.cache
